        Route::get('/{id}/edit', [ForeignAccountController::class, 'edit'])->name('edit');
        Route::put('/{id}', [ForeignAccountController::class, 'update'])->name('update');
        Route::get('/view/{id}', [ForeignAccountController::class, 'show'])->name('show');
        Route::delete('/{id}', [ForeignAccountController::class, 'destroy'])->name('destroy');
    });
    
    Route::prefix('exchange-rates')->name('exchange.rates.')->group(function () {
        Route::get('/', [ExchangeRateController::class, 'index'])->name('index');
        Route::get('/{id}/edit', [ExchangeRateController::class, 'edit'])->name('edit');
        Route::put('/{id}', [ExchangeRateController::class, 'update'])->name('update');
