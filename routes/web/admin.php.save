    Route::post('users/send-notification/{username}', [UserController::class, 'sendUserNotification'])->name('AdminSendUserNotification');
    Route::post('users/change-password/{username}', [UserController::class, 'changePassword'])->name('AdminChangeUserPassword');
    
    Route::post('users/activate-deactivate/{username}', [UserController::class, 'activateDeactivateUser'])->name('AdminActivateDeactivateUser');
    Route::post('users/banUnban/{username}', [UserController::class, 'banUnbanUser'])->name('AdminBanUnbanUser');
    Route::post('users/blockUnblock/{username}', [UserController::class, 'blockUnblockUser'])->name('AdminBlockUnblockUser');
    Route::get('user/transactions/{username}', [UserController::class, 'showTransaction'])->name('AdminUserTransaction');
    Route::delete('users/delete/{username}', [UserController::class, 'distoryUser'])->name('AdminDeleteUser');
