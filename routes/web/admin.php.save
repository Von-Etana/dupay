    Route::get('transactions-reciept/{reference}', [TransactionController::class, 'downloadPDF'])->name('AdminDownloadReciept');
    Route::delete('transactions-delete/{reference}', [TransactionController::class, 'destroy'])->name('DeleteTransaction');
    Route::get('transactions-{reference}', [TransactionController::class, 'transactionDetails'])->name('TransactionDetails');
    Route::post('transactions-edit-status/{type}/{reference}', [TransactionController::class, 'editTransactionStatus'])->name('editTransactionStatus');
    Route::post('transactions/bulk/delete',[TransactionController::class, 'bulk_delete'])->name('transactions.bulk_delete');
    Route::post('transactions-edit-bulk-status/', [TransactionController::class, 'editBulkTransactionStatus'])->name('editBulkTransactionStatus');
