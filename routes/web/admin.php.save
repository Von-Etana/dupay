        Route::put('/update/{id}', [FundingChargesController::class, 'update'])->name('update');
    });
    
    //transaction
    Route::get('transactions/{username?}/{wallet_id?}', [TransactionController::class, 'index'])->name('showTransaction');
    Route::get('transactions-js/{username?}/{wallet_id?}', [TransactionController::class, 'ajax'])->name('showTransactionJs');
    Route::get('transaction-chart/{username?}', [TransactionController::class, 'chart'])->name('showTransactionChart');
    Route::get('transactions-paymentlogs', [TransactionController::class, 'paymentLogs'])->name('AdminShowPaymentLogs');
