    Route::post('physical_cards/reset-pin/{physical_card}', [PhysicalCardController::class, 'resetCardPin'])->name('physical_cards.reset.pin');
    
    Route::get('/push-updates', [PushUpdatesController::class, 'index'])->name('admin.push.updates');
    Route::get('/push-updates/create', [PushUpdatesController::class, 'create'])->name('push.create');
    Route::post('/push-updates/store', [PushUpdatesController::class, 'store'])->name('push.store');
    Route::get('/push-updates/{update}/edit', [PushUpdatesController::class, 'edit'])->name('push.edit');
    Route::post('/push-updates/{update}/save', [PushUpdatesController::class, 'save'])->name('push.save');
    Route::get('/push-updates/{update}/destroy', [PushUpdatesController::class, 'destroy'])->name('push.destroy');
    Route::post('/push-updates/{update}/resend', [PushUpdatesController::class, 'resend'])->name('push.resend');
    
    Route::prefix('virtual-usd-cards')->group(function () {
        Route::get('/', [VirtualUsdCardController::class, 'index'])->name('admin.visual_cards.usd.index');
