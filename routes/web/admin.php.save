Route::group(['prefix' => 'adminoffice'], function () {

    //admin auth
    Route::group(['namespace'=>'Auth','middleware'=>['AdminGuest','visitors'],'as'=>'adminAuth.'],function(){
    
        // Route::get('login', [AuthController::class, 'showLoginForm'])->name('Login');
        // Route::post('login', [AuthController::class, 'Login'])->name('AdminLogin');
        Route::get('login', [LoginController::class, 'showLoginForm'])->name('Login');
        Route::post('login', [LoginController::class, 'Login'])->name('AdminLogin');
        
    
    });

    Route::get('/pin', [PinController::class,'showForm'])->name('admin.pin.form')->middleware('Admin');
    Route::post('/pin', [PinController::class,'verifyPin'])->name('admin.pin.verify')->middleware('Admin');

    // Route::get('logout', [AuthController::class, 'logout'])->name('AdminLogout')->middleware('Admin');
    Route::get('logout', [LoginController::class, 'logout'])->name('AdminLogout')->middleware('Admin');
    
    Route::get('forgot-pin',[ForgotPinController::class,'requestForm'])
        ->name('admin.pin.forgot');

    Route::post('forgot-pin',[ForgotPinController::class,'sendLink'])
        ->name('admin.pin.email');

    Route::get('reset-pin/{token}',[ForgotPinController::class,'resetForm'])
        ->name('admin.pin.reset.form');

    Route::post('reset-pin',[ForgotPinController::class,'resetPin'])
        ->name('admin.pin.reset');



    //admin controls
    Route::group(['middleware'=>['Admin', 'visitors', 'admin.pin'],'as'=>'admin.'],function(){

    //dashboard
    Route::get('/', [DashboardController::class, 'index'])->name('index');

    // Light/Dark theme toggle for the DeWallet admin (sets a cookie, redirects back)
    Route::get('toggle-theme', function () {
        $current = request()->cookie('dupay_theme', 'dark');
        $next = $current === 'light' ? 'dark' : 'light';
        // 1 year cookie, applies across the admin
        return redirect()->back()->withCookie(cookie('dupay_theme', $next, 60 * 24 * 365));
    })->name('toggleTheme');
    Route::get('/sales', [DashboardController::class, 'sales'])->name('sales');
    Route::post('sales-calculator', [SalesController::class, 'calculateSales'])->name('salesCalculate');
    
    
    
    Route::post('/verify-pin', [PinController::class, 'verify'])
    ->name('verify.pin');
    
    
    //user
    Route::resource('user', UserController::class);
    Route::get('get-user', [UserController::class, 'ajax'])->name('getUser');
    Route::post('users/update-js/{username}', [UserController::class, 'jsUpdate'])->name('UserUpdateJsAction');
    Route::post('users/update-js2/{username}', [UserController::class, 'updateReceiveSms'])->name('UserUpdateJsAction2');
    
    Route::get('users/wallet-action/{username}', [UserController::class, 'userWalletAction'])->name('AdminUserWalletAction');
    Route::post('users/wallet-action/{username}', [UserController::class, 'updateUserWallet'])->name('AdminUserWalletAction');
    
    Route::get('users/level-action/{username}', [UserController::class, 'userLevelAction'])->name('AdminUserLevelAction');
    Route::post('users/level-action/{username}', [UserController::class, 'updateUserLevel'])->name('AdminUserLevelAction');
    
    Route::post('users/transaction-pin/{username}', [UserController::class, 'resetTransactionPin'])->name('AdminResetUserTransactionPin');
