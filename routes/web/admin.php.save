        Route::post('/update', [StampDutyController::class, 'update'])->name('update');
    });
    
    Route::prefix('vat_settings')->name('vat.')->group(function () {
        Route::get('/', [VATSettingsController::class, 'index'])->name('index');
        Route::post('/update', [VATSettingsController::class, 'update'])->name('update');
    });
    
    Route::prefix('error_log')->name('error.log.')->group(function () {
        Route::get('/', [ErrorLogController::class, 'index'])->name('index');
    });
    
    Route::prefix('deposit-fee')->name('deposit.fee.')->group(function () {
        Route::get('/{currency}', [DepositFeeController::class, 'index'])->name('index');
        Route::get('/edit/{id}', [DepositFeeController::class, 'edit'])->name('edit');
        Route::put('/update/{id}', [DepositFeeController::class, 'update'])->name('update');
    });
    
    Route::prefix('funding-charge')->name('funding.charge.')->group(function () {
