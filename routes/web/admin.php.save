    Route::get('user/fyc/transactions/{id}', [UserController::class, 'transactions'])->name('user.fyc.transactions');
    Route::get('user/fyc/transactions/ajax/{id}', [UserController::class, 'transactionsAjax'])->name('user.fyc.transactions.ajax');
    Route::get('user/fyc/transactions/delete', [UserController::class, 'destroyTranx'])->name('user.fyc.transactions.destroy');
    
    Route::post('user/daily-limit/update/{username}',[UserController::class, 'updateDailyTransactionLimit'])->name('user.updateDailyTransactionLimit');
    
    
    
