        Route::post('/cards/freeze', [VirtualUsdCardController::class, 'freeze'])->name('visual_cards.usd.freeze');
        Route::post('/{id}/unfreeze', [VirtualUsdCardController::class, 'unfreeze'])->name('admin.visual_cards.usd.unfreeze');
        Route::post('/fund', [VirtualUsdCardController::class, 'fund'])->name('visual_cards.usd.fund');
        Route::post('/withdraw', [VirtualUsdCardController::class, 'withdraw'])->name('visual_cards.usd.withdraw');
        Route::get('/{id}/transactions', [VirtualUsdCardController::class, 'transactions'])->name('admin.visual_cards.usd.transactions');
        Route::delete('/destroy/{id}', [VirtualUsdCardController::class, 'destroy'])->name('admin.visual_cards.usd.destroy');
    });
    
    Route::prefix('virtual-ngn-cards')->group(function () {
        Route::get('/', [VirtualNGNCardController::class, 'index'])->name('visual_cards.ngn.index');
        Route::get('/{id}', [VirtualNGNCardController::class, 'show'])->name('visual_cards.ngn.show');
        Route::post('/cards/freeze', [VirtualNGNCardController::class, 'freeze'])->name('visual_cards.ngn.freeze');
        Route::post('/{id}/unfreeze', [VirtualNGNCardController::class, 'unfreeze'])->name('visual_cards.ngn.unfreeze');
        Route::post('/reset', [VirtualNGNCardController::class, 'reset'])->name('visual_cards.ngn.reset');
        Route::delete('/destroy/{id}', [VirtualNGNCardController::class, 'destroy'])->name('visual_cards.ngn.destroy');
    });
    
    Route::prefix('foreign-accounts/request')->name('foreign-accounts.')->group(function () {
        Route::get('/', [ForeignAccountRequestController::class, 'index'])->name('index');
        Route::get('/{id}', [ForeignAccountRequestController::class, 'show'])->name('show');
        Route::get('/{id}/edit', [ForeignAccountRequestController::class, 'edit'])->name('edit');
        Route::put('/{id}', [ForeignAccountRequestController::class, 'update'])->name('update');
        Route::delete('/{id}', [ForeignAccountRequestController::class, 'destroy'])->name('destroy');
    
        Route::post('/{id}/approve', [ForeignAccountRequestController::class, 'approve'])->name('approve');
