{
  "defaultPlatform": "android",
  "platforms": {
    "android": {
      "build": {
        "profiles": {
          "development": {
            "command": "cd mobile && flutter build apk --debug --dart-define=ENV=prod",
            "artifact": "mobile/build/app/outputs/flutter-apk/app-debug.apk"
          }
        }
      },
      "appId": "dupay-2ntbs6y1",
      "deviceCategory": "phone"
    },
    "ios": {
      "build": {
        "profiles": {
          "development": {
            "command": "cd mobile && flutter build ios --simulator --debug --dart-define=ENV=prod",
            "artifact": "mobile/build/ios/iphonesimulator/Runner.app"
          },
          "production": {
            "command": "cd mobile && flutter build ipa --release --export-options-plist=ios/ExportOptions.plist",
            "artifact": "mobile/build/ios/ipa/*.ipa"
          }
        }
      }
    }
  },
  "metroPort": 8081
}
